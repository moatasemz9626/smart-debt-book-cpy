# Migration-owner connection URL (never exposed in browser)
DATABASE_MIGRATION_URL=postgresql://MIGRATION_USER:SECRET@HOST:5432/postgres?sslmode=require
# Runtime must use a separate restricted non-owner role, set per-transaction app context
DATABASE_RUNTIME_URL=postgresql://sdb_app:SECRET@POOLER_HOST:6543/postgres?sslmode=require
# Supabase Auth verification keys are managed separately by the backend, never in PWA.
# Supabase Auth (public URL + anon key). DB tests sign up real test users through it.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=PUBLIC_ANON_KEY
# Local dev: `npx supabase start`, `npm run db:migrate`, then `npm run db:local-setup` fills all of the above.
